# ------ Elite v2 Enterprise-Advanced Settings ------------------------------------------------------------------------------------------------------

# LLM provider for elite v2 features (default: MAI_LLM value)

# CHUNK_ELITE_LLM_PROVIDER=ollama

# Enable proposition-based chunking (atomic facts via LLM)

# CHUNK_ELITE_PROPOSITIONS=false

# Enable agentic semantic splitting (LLM-based topic detection)

# CHUNK_ELITE_AGENTIC_SPLIT=false

# Gist mode: "llm" (default) or "extractive"

# CHUNK_ELITE_GIST_MODE=llm

# Coherence threshold for dynamic overlap (below this --- add overlap)

# CHUNK_ELITE_COHERENCE_THRESHOLD=0.6



# =============================================

# Celery --- Distributed Task Queue (Pluggable Broker)

# =============================================

# Master switch: true = offload ingestion to Celery workers (fast, scalable)

#                false = inline ingestion inside the API process (slower, no broker needed)

CELERY_ENABLED=false



# Broker type --- which message broker Celery connects to.

# Change this ONE line to swap the entire broker platform.

#

# Tier 1 --- Native (zero extra packages):

#   redis            Your existing Redis (default)

#   rabbitmq         RabbitMQ / CloudAMQP / Amazon MQ

#   sqs              Amazon SQS

#

# Tier 2 --- Community (one extra pip package):

#   kafka            Apache Kafka / Confluent Cloud       (pip install celery-kafka)

#   redpanda         Redpanda (Kafka-compatible)          (pip install celery-kafka)

#   warpstream       WarpStream (Kafka-compatible)        (pip install celery-kafka)

#   nats             NATS JetStream                       (pip install celery-nats)

#   pulsar           Apache Pulsar                        (pip install celery-pulsar)

#

# Tier 3 --- Cloud / managed (Kafka or AMQP adapter):

#   kinesis          Amazon Kinesis

#   pubsub           Google Cloud Pub/Sub                 (pip install kombu[gcpubsub])

#   eventhubs        Azure Event Hubs (Kafka endpoint)

#   upstash          Upstash Redis or Kafka

#   redis_streams    Redis Streams (Redis >= 5.0)

#   tinybird         Tinybird (Kafka-compatible)

#   glassflow        GlassFlow (Kafka-compatible)

#   streamnative     StreamNative (Pulsar-compatible)

#   aiven            Aiven for Kafka

CELERY_BROKER=kafka



# -- Per-broker connection settings -------------------

# Only the block matching your CELERY_BROKER is read.

# The rest are ignored.



# Redis (default) --- reuses your existing Redis instance

CELERY_REDIS_URL=redis://default:passsword@localhost:6379/0

# Result backend: set to a Redis URL for task status visibility via REST/WebSocket.

# Set to "disabled" only if you truly don't need task state tracking.
# Defaults to CELERY_REDIS_URL when blank. Set explicitly for production.

CELERY_RESULT_BACKEND=redis://default:passsword@localhost:6379/0



# RabbitMQ

# RABBITMQ_URL=amqp://guest:guest@localhost:5672//



# Kafka / Redpanda / WarpStream / Aiven / Tinybird / GlassFlow / EventHubs

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KAFKA_SECURITY_PROTOCOL=PLAINTEXT

KAFKA_SASL_MECHANISM=PLAIN

KAFKA_SASL_USERNAME=

KAFKA_SASL_PASSWORD=



# NATS JetStream

# NATS_URL=nats://localhost:4222



# Apache Pulsar / StreamNative

# PULSAR_URL=pulsar://localhost:6650



# Amazon SQS (uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from env)

# SQS_REGION=us-east-1

# SQS_QUEUE_PREFIX=mai-



# Google Cloud Pub/Sub

# GOOGLE_CLOUD_PROJECT=your-project-id

# PUBSUB_SUBSCRIPTION_PREFIX=mai-



# Upstash (auto-detects redis or kafka mode)

# UPSTASH_BROKER_TYPE=redis



# ------ Celery Worker Configuration ---------------------------------------------------------------------------------------------------------------------------------------

# Pool type: solo (safe on Windows), prefork (Linux/Mac default), threads, gevent, eventlet

CELERY_WORKER_POOL=solo

CELERY_WORKER_CONCURRENCY=4

CELERY_WORKER_LOGLEVEL=INFO

CELERY_WORKER_QUEUES=ingestion,validation

CELERY_WORKER_MAX_TASKS_PER_CHILD=0

CELERY_WORKER_PREFETCH_MULTIPLIER=1

CELERY_TASK_SOFT_TIME_LIMIT=0

CELERY_TASK_HARD_TIME_LIMIT=0

CELERY_TASK_MAX_RETRIES=3

CELERY_TASK_RETRY_DELAY=60

CELERY_RESULT_EXPIRES=86400

CELERY_WORKER_DISABLE_HEARTBEAT=true

CELERY_WORKER_DISABLE_GOSSIP=true

CELERY_WORKER_DISABLE_MINGLE=true



# =============================================

# Apache Kafka --- Enterprise Event Streaming

# =============================================

# Independent of Celery broker --- Kafka events are a parallel event bus

# for real-time ingestion lifecycle events, validation notifications,

# and connector streaming.

#

# Master switch: true = publish ingestion/validation events to Kafka topics

#                false = no Kafka event publishing (Celery + inline still work)

KAFKA_EVENTS_ENABLED=false



# ------ Producer --- Performance & Reliability ---------------------------------------------------------------------------------------------------------------

KAFKA_CLIENT_ID=mai-producer

KAFKA_ENABLE_IDEMPOTENCE=true

KAFKA_ACKS=all

KAFKA_COMPRESSION_TYPE=lz4

KAFKA_LINGER_MS=5

KAFKA_BATCH_SIZE=65536

KAFKA_BATCH_NUM_MESSAGES=10000

KAFKA_RETRIES=2147483647

KAFKA_RETRY_BACKOFF_MS=100

KAFKA_RETRY_BACKOFF_MAX_MS=10000

KAFKA_DELIVERY_TIMEOUT_MS=120000

KAFKA_MAX_IN_FLIGHT=5

KAFKA_MESSAGE_MAX_BYTES=1048576

KAFKA_QUEUE_BUFFERING_MAX_MESSAGES=100000

KAFKA_QUEUE_BUFFERING_MAX_KBYTES=1048576



# ------ Consumer ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

KAFKA_CONSUMER_GROUP_ID=mai-consumer-group

KAFKA_AUTO_OFFSET_RESET=earliest

KAFKA_ENABLE_AUTO_COMMIT=false

KAFKA_MAX_POLL_INTERVAL_MS=300000

KAFKA_SESSION_TIMEOUT_MS=45000

KAFKA_HEARTBEAT_INTERVAL_MS=3000

KAFKA_FETCH_MIN_BYTES=1

KAFKA_FETCH_MAX_BYTES=52428800

KAFKA_MAX_PARTITION_FETCH_BYTES=1048576



# ------ SSL/TLS (for SASL_SSL or SSL protocol) ------------------------------------------------------------------------------------------------------

KAFKA_SSL_CA_LOCATION=

KAFKA_SSL_CERTIFICATE_LOCATION=

KAFKA_SSL_KEY_LOCATION=

KAFKA_SSL_KEY_PASSWORD=

KAFKA_SSL_ENDPOINT_IDENTIFICATION=none



# ------ OAUTHBEARER (for managed clouds) ------------------------------------------------------------------------------------------------------------------------

KAFKA_OAUTHBEARER_CONFIG=



# ------ Schema Registry (Confluent-compatible, optional) ------------------------------------------------------------------------

KAFKA_SCHEMA_REGISTRY_URL=

KAFKA_SCHEMA_REGISTRY_AUTH=



# ------ Topic Defaults ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

KAFKA_DEFAULT_PARTITIONS=3

KAFKA_DEFAULT_REPLICATION_FACTOR=1

KAFKA_TOPIC_RETENTION_MS=604800000

KAFKA_TOPIC_CLEANUP_POLICY=delete



# ------ Connector (Kafka as ingestion source) ------------------------------------------------------------------------------------------------------------

KAFKA_CONNECTOR_GROUP_ID=mai-connector-group

KAFKA_CONNECTOR_MAX_MESSAGES=100

KAFKA_CONNECTOR_POLL_TIMEOUT_S=10



# ------ Service Threads ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

KAFKA_SERVICE_THREADS=4

KAFKA_STATS_INTERVAL_MS=60000

AI_PROFILE=cpu

VISION_MODEL_CPU=Qwen/Qwen2.5-VL-3B-Instruct

DEFAULT_TOKENIZER_BACKEND=huggingface
CHUNK_OVERLAP=20
HF_TOKENIZER_MODEL=bert-base-multilingual-cased
EMBED_CACHE_REDIS=false
CHUNK_SIZE=390
GOOGLE_EMBED_MODEL=gemini-embedding-001

# =============================================================
# Unified Chunking-Tokenization Alignment (Phase 2)
# =============================================================

# Master switch — when true, all chunking strategies use the
# embedding model's native tokenizer for accurate token counts
# instead of the generic BERT factory backend.
# Phase 0 (false) = legacy behavior (BERT for all strategies).
# Phase 1 (true)  = model-native tokenizer injected via ContextVar.
USE_MODEL_NATIVE_TOKENIZER_FOR_CHUNKING=false

# Per-provider soft_cap factors.
# soft_cap = floor(embed_max_tokens * factor).
# Chunks with model-native token count <= soft_cap are guaranteed safe.
# Lower factors = more conservative (fewer remote re-check calls for Gemini).
GEMINI_CHUNK_SOFT_CAP_FACTOR=0.85
OPENAI_CHUNK_SOFT_CAP_FACTOR=0.92
COHERE_CHUNK_SOFT_CAP_FACTOR=0.88
HF_CHUNK_SOFT_CAP_FACTOR=0.98
OLLAMA_CHUNK_SOFT_CAP_FACTOR=0.96
MISTRAL_CHUNK_SOFT_CAP_FACTOR=0.92
DEFAULT_CHUNK_SOFT_CAP_FACTOR=0.90

# LRU cache size for ChunkingTokenCounter (entries per document pipeline).
CHUNKING_TOKEN_COUNTER_CACHE_SIZE=512
