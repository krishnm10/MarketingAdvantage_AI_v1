# -- HF Inference API (remote mode) --------------------------

# Set HF_USE_API=true to POST to HF Inference API instead of running locally.

# Set HF_USE_API=false (default) to use local sentence-transformers (faster on your 32GB/8-core).

HF_USE_API=false

HF_API_KEY=hf_YOUR_TOKEN_HERE

# Base URL - override for private Hub, enterprise gateway, or self-hosted TEI server.

# Default: https://api-inference.huggingface.co/models

# Final URL = HF_BASE_URL / HF_EMBED_MODEL   (built dynamically at runtime)

HF_BASE_URL=https://api-inference.huggingface.co/models

# Max texts per single API POST (HF free tier caps at ~96, pro at 512)

HF_API_MAX_BATCH=96

























