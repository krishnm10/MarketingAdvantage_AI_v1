# -- Global defaults --------------------------

# Used for ALL businesses unless overridden per-business below.

MAI_VECTORDB=chroma          # chroma | qdrant | pinecone | milvus | weaviate | redis

MAI_EMBEDDER=huggingface       # ollama | openai | huggingface | cohere | gemini

MAI_LLM=ollama               # ollama | openai | grok | anthropic | gemini

MAI_RERANKER=none            # none | crossencoder | bge_reranker | flashrank | cohere
MAI_RERANKER_MODEL=gpt-oss:120b-cloud        # leave blank for default per provider (e.g. cross-encoder/ms-marco-MiniLM-L-12-v2)

MAI_COLLECTION=ingested_content

# ── Retrieval thresholds ──────────────────────────────────────────────────────
# Minimum composite governance score for LLM answer generation (0.0–1.0).
# The composite score = semantic × trust × conflict × temporal — NOT raw cosine.
# Typical real-data scores: 0.30–0.60. Values above 0.6 will block most results.
RAG_ANSWER_MIN_SCORE=0.25



