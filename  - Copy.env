OLLAMA_API_URL=http://localhost:11434/api/generate
LLAMA_MODEL=gpt-oss:120b-cloud
DEEPSEEK_MODEL=llama3.1:8b
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost/marketing_advantage
VITE_API_URL=http://127.0.0.1:8000
SERPER_API_KEY=CHANGE_ME
SEARCH_RESULTS_LIMIT=3
SEARCH_CACHE_FILE=search_cache.json
SEARCH_CACHE_EXPIRY_HOURS=24
AI_IMAGE_MODEL=deepai
DEEPAI_API_KEY=CHANGE_ME
JWT_SECRET=your_strong_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# â”€â”€ TOKEN-AWARE CHUNKING â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Backend: huggingface | spacy | nltk | whitespace
DEFAULT_TOKENIZER_BACKEND=whitespace
# Token-count-based chunk sizing (used by token_aware chunking strategy)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# HuggingFace model for tokenization (used when backend=huggingface)
# Options: bert-base-multilingual-cased, ai4bharat/indic-bert, bert-base-uncased
HF_TOKENIZER_MODEL=bert-base-multilingual-cased
# spaCy model (used when backend=spacy)
SPACY_MODEL=en_core_web_sm

