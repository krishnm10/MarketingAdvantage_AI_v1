# Slim .env — infrastructure, brokers, and secrets only.
# Per-tenant models, chunking, tokenization, PHANTOM tuning, dedup L3 knobs,
# and Celery dispatch (queue names, retries) live in merged Client JSON
# (app/core/configs/default.json + app/core/configs/<client_id>.json).
# See app/core/configs/_templates/tenant_config.template.json

DATABASE_URL=postgresql+asyncpg://localhost/marketingai
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

JWT_SECRET_KEY=
LOG_FORMAT=text
PORT=8000

CELERY_ENABLED=false
CELERY_BROKER=redis
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_WORKER_QUEUES=ingestion,validation

# Optional bootstrap tenant when no explicit client id is supplied (infra only).
MAI_DEFAULT_BUSINESS_ID=default
