{
  "client_id": "splunk",
  "client_name": "Splunk",
  "version": "1.0",
  "vectordb": {
    "type": "chroma",
    "collection": "ingested_content",
    "chroma": {
      "persist_directory": "./pluggable_db"
    }
  },
  "embedder": {
    "type": "huggingface",
    "huggingface": {
      "model": "BAAI/bge-large-en-v1.5",
      "device": "auto"
    }
  },
  "retrieval": {
    "search_mode": "semantic",
    "enable_token_budget": true,
    "token_budget_context_fraction": 0.6
  },
  "llm": {
    "single": {
      "type": "gemini",
      "model": "gemini-2.5-flash",
      "api_key_env": "GOOGLE_API_KEY",
      "base_url": "https://generativelanguage.googleapis.com/v1"
    }
  },
  "security": {
    "pii_middleware": {
      "enabled": true,
      "positions": [
        "pre_embedding",
        "pre_llm",
        "post_llm"
      ],
      "action": "REDACT",
      "block_on_severity": "CRITICAL",
      "trust_score_penalty": 0.15,
      "audit_log_enabled": true
    }
  },
  "prompt": {
    "enabled": true,
    "prompt_type": "refine",
    "max_tokens_warning": 3000
  },
  "formatter": {
    "enabled": true,
    "response_format": "plain_text",
    "min_trust_score": 0.3,
    "block_on_low_trust": true
  },
  "context_window": {
    "enabled": true,
    "truncation_strategy": "least_relevant",
    "response_reserve_tokens": 1024
  }
}