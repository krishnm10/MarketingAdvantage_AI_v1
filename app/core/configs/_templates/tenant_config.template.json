{
  "_comment": "Overlay template — merge with default.json via client_config_resolver. Pipeline secrets stay in .env (api_key_env names only here).",
  "client_id": "your_tenant_id",
  "retrieval": {
    "prompt_template_id": "preset-rag-context"
  },
  "prompt": {
    "enabled": true,
    "prompt_type": "rag_context",
    "max_tokens_warning": 3000,
    "template": null
  },
  "ingestion": {
    "batch_size": 256,
    "embed_parallelism": 4,
    "allow_legacy_env_overrides": false,
    "visual_llm_concurrency": 4,
    "phantom": {
      "embed_batch_size": 64,
      "embed_prefetch": 2,
      "upsert_batch_size": 128,
      "upsert_concurrency": 2,
      "ingest_workers": 4,
      "parse_workers": 4,
      "io_thread_pool": 8,
      "bloom_capacity": 2000000,
      "bloom_error_rate": 0.001,
      "l2_dedup_batch": 32,
      "gravity_clusters": 16,
      "gravity_batch_size": 512,
      "stage_collapse_concurrency": 4
    },
    "chunking": {
      "strategy": "semantic",
      "chunk_size": 512,
      "chunk_overlap": 64,
      "min_chunk_len": 30
    },
    "deduplication": {
      "enable_hash_dedup": true,
      "enable_embedding_dedup": true,
      "enable_gci_dedup": true,
      "similarity_threshold": 0.95,
      "l3_redis_threshold": 500,
      "l3_embed_batch_size": 64,
      "l3_search_concurrency": 32
    }
  },
  "tokenization": {
    "default_tokenizer_backend": "huggingface",
    "hf_tokenizer_model": "bert-base-multilingual-cased",
    "use_model_native_tokenizer_for_chunking": true,
    "chunking_token_counter_cache_size": 512
  },
  "celery_dispatch": {
    "ingestion_queue": "ingestion",
    "validation_queue": "validation",
    "max_retries": 3,
    "retry_delay_seconds": 60,
    "soft_time_limit": 0,
    "hard_time_limit": 0
  }
}
