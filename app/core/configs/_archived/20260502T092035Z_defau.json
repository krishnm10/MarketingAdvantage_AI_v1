{
  "client_id": "defau",
  "client_name": "Defau",
  "version": "1.0",
  "vectordb": {
    "type": "chroma",
    "collection": "ingested_content",
    "chroma": {
      "persist_directory": "./pluggable_db"
    }
  },
  "embedder": {
    "type": "huggingface",
    "huggingface": {
      "model": "BAAI/bge-large-en-v1.5",
      "device": "auto"
    }
  },
  "retrieval": {
    "search_mode": "hybrid",
    "enable_token_budget": true,
    "token_budget_context_fraction": 0.6,
    "enable_threshold_gate": false,
    "threshold_min_score": 0.0,
    "threshold_min_results": 1,
    "enable_hyde": true,
    "enable_multi_query": true,
    "multi_query_count": 4,
    "hybrid_alpha": 0.7
  },
  "llm": {
    "single": {
      "type": "ollama",
      "model": "gpt-oss:120b-cloud",
      "base_url": "http://localhost:11434"
    }
  },
  "reranker": {
    "model": "flashrank/ms-marco-MiniLM-L-12-v2",
    "type": "flashrank",
    "top_k": 5
  }
}