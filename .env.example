# =============================================================================
# MarketingAdvantage AI — deployment environment (infrastructure only)
# =============================================================================
#
# Pipeline configuration (embedder, vector DB, LLM, chunking, retrieval, secrets)
# is managed per tenant via the Admin UI → Settings → Pipeline Builder.
# Do NOT add MAI_*, CHROMA_*, OPENAI_*, or other pipeline keys here.
#
# Copy to `.env` and fill in values. Never commit `.env` to git.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost/marketing_advantage

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional dev users: user:pass,user2:pass2
AUTH_USERS=

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=*
ENVIRONMENT=development

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=200/minute
REDIS_URL=memory://

# ── Observability ────────────────────────────────────────────────────────────
LOG_FORMAT=text
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=marketing-advantage-ai

# ── Celery (optional distributed workers) ────────────────────────────────────
CELERY_ENABLED=false
CELERY_BROKER=redis
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_WORKER_QUEUES=ingestion,validation
CELERY_WORKER_POOL=solo

# ── Message brokers (when CELERY_BROKER is not redis-only) ─────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NATS_URL=nats://localhost:4222
PULSAR_URL=pulsar://localhost:6650

# ── Platform bootstrap ───────────────────────────────────────────────────────
# Default tenant when no explicit client_id is supplied (infra routing only).
MAI_DEFAULT_BUSINESS_ID=default

# ── Scheduler / validation jobs (optional) ───────────────────────────────────
ENABLE_AGENTIC_VALIDATION=true
ENABLE_CONFLICT_ANALYSIS=true
ENABLE_TEMPORAL_REVALIDATION=true
VALIDATION_INTERVAL=60
CONFLICT_INTERVAL=120
TEMPORAL_INTERVAL=300

# ── Security / ops ───────────────────────────────────────────────────────────
TENANT_ENFORCEMENT_MODE=strict
INTERNAL_HEALTH_TOKEN=

# ── LLM API keys (tenant JSON secret_ref may point here; optional per provider) ─
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# HF_TOKEN=hf_...  # HuggingFace token (Pro may be required for router.huggingface.co/v1)
